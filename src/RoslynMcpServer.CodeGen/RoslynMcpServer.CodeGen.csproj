<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RoslynMcpServer.CodeGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoslynMcpServer\RoslynMcpServer.csproj" />
    <ProjectReference Include="..\SharpOps\SharpOps.csproj" />
    <ProjectReference Include="..\SharpOps.Torch\SharpOps.Torch.csproj" />
  </ItemGroup>

  <!-- Copy SharpTinyCoder model files to output directory -->
  <ItemGroup>
    <Content Include="..\RoslynMcpServer\SharpOps\Models\**\*" CopyToOutputDirectory="PreserveNewest" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
